# ---------------------------------------------------------------------------
# Cafe Re faire 公式サイト — 環境変数のひな形
#
# 手元で使うとき: このファイルを .env.local という名前で写して、値を入れる。
# 本番のサイト（Vercel）: 入れなくても動く（公開 URL は next.config.ts の PRODUCTION_URL）。
# 毎日の自動投稿（GitHub Actions）: キーはリポジトリの Settings → Secrets and variables → Actions に置く。
#
# .env.local はリポジトリに入らない（.gitignore で外してある）。
# API キーやトークンを、このファイルやソースコードに書かないこと。
# ---------------------------------------------------------------------------

# 公開 URL。ふだんは入れない（本番のドメインは next.config.ts の PRODUCTION_URL で、Vercel の本番ビルドだけで使われる）。
# 手元で本番と同じ出力（canonical・sitemap・構造化データ）を確かめるときだけ入れる。末尾の / は付けない。
# 例: NEXT_PUBLIC_SITE_URL=https://www.cafe-re-faire.com
NEXT_PUBLIC_SITE_URL=

# ---- 記事を書く（npm run blog:dry-run / blog:generate） -------------------
# 本番の毎日の投稿は GitHub Actions が行う（.github/workflows/daily-post.yml）。
# そこでは、同じ名前を Secrets（ANTHROPIC_API_KEY）と Variables（ANTHROPIC_MODEL）に置く。

# Claude API のキー（https://platform.claude.com/ で発行）
ANTHROPIC_API_KEY=

# 使うモデル。省くと claude-haiku-4-5（費用を抑えるための既定）。
# 文章の質を上げたいときは claude-sonnet-5-5 などに替える。
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- 任意 ------------------------------------------------------------------

# Google Search Console の所有権の確認（HTML タグ方式の content の値）。使うときは Vercel に入れる
GOOGLE_SITE_VERIFICATION=
