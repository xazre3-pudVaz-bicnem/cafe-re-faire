# ---------------------------------------------------------------------------
# Cafe Re faire 公式サイト — 環境変数のひな形
#
# 手元で使うとき: このファイルを .env.local という名前で写して、値を入れる。
# 本番（Vercel）: Project Settings → Environment Variables に、同じ名前で登録する。
#
# .env.local はリポジトリに入らない（.gitignore で外してある）。
# API キーやトークンを、このファイルやソースコードに書かないこと。
# ---------------------------------------------------------------------------

# 公開 URL（本番のドメイン）。末尾の / は付けない。
# 入っていない間は、全ページが noindex になり、sitemap も空になる（プレビューを検索結果に載せないため）。
# Vercel では「Production」の環境にだけ登録する。
NEXT_PUBLIC_SITE_URL=

# ---- 毎日の自動投稿（/api/cron/daily-post） --------------------------------

# Claude API のキー（https://platform.claude.com/ で発行）
ANTHROPIC_API_KEY=

# 使うモデル。省くと claude-haiku-4-5（費用を抑えるための既定）。
# 文章の質を上げたいときは claude-sonnet-5-5 などに替える。
ANTHROPIC_MODEL=claude-haiku-4-5

# Vercel Cron からの呼び出しであることを確かめる合言葉。16文字以上の、でたらめな文字列。
# 例: openssl rand -hex 32 で作る。
CRON_SECRET=

# 記事をコミットする先の GitHub リポジトリ。
# トークンは Fine-grained personal access token。対象はこのリポジトリ1つだけ、
# 権限は「Contents: Read and write」だけにする。
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# コミットするブランチ。省くと main。
GITHUB_BRANCH=main

# ---- 任意 ------------------------------------------------------------------

# Google Search Console の所有権の確認（HTML タグ方式の content の値）
GOOGLE_SITE_VERIFICATION=

# GitHub の API の場所。ふつうは設定しない（GitHub Enterprise を使うときだけ）。
# GITHUB_API_URL=https://api.github.com
